{
  "profile_name": "Books to Scrape Engine",
  "target_domain": "books.toscrape.com",
  "container_selector": "article.product_pod",
  "rules": [
    {
      "field_name": "title",
      "rule_type": "attribute",
      "expression": "h3 a",
      "attribute": "title",
      "data_type": "string",
      "required": true
    },
    {
      "field_name": "price",
      "rule_type": "css_selector",
      "expression": "p.price_color",
      "data_type": "decimal",
      "required": true
    },
    {
      "field_name": "product_url",
      "rule_type": "link_attribute",
      "expression": "h3 a",
      "attribute": "href",
      "data_type": "url",
      "required": true
    },
    {
      "field_name": "availability",
      "rule_type": "css_selector",
      "expression": "p.instock.availability",
      "data_type": "string",
      "required": false
    }
  ]
}