# StrataFetch Configuration Settings
APP_NAME="StrataFetch Web Data Acquisition Platform"
ENV="development"
DEBUG=true

# Database Settings
DATABASE_URL="sqlite+aiosqlite:///./stratafetch.db"

# Scraper Security & Politeness Controls
MAX_CONCURRENT_REQUESTS=5
DEFAULT_REQUEST_TIMEOUT_SECONDS=30
ENABLE_SSRF_PROTECTION=true
ALLOWED_SCHEMES="http,https"